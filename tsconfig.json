{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@protocols/*": ["src/protocols/*"],
      "@ui/*": ["src/ui/*"],
      "@modules/*": ["modules/*"],
      "@tests/*": ["tests/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts",
    "tests/**/*.ts"
  ]
}
